# Optional for free collection; required only with --enable-paid.
OCW_PUMPPORTAL_KEY=
# Optional minimal outage webhook; not a signal channel. Never commit the real URL.
OCW_DISCORD_STATUS_URL=
# Optional staging-only volume channel. Ignored unless --enable-staging-delivery is present.
OCW_DISCORD_STAGING_URL=
# Optional independent Solana HTTPS RPC, read only. Used only with probe.enabled=true.
SOLANA_RPC_URL=
# Optional external disappearance monitor, used only with monitor.deadman=true.
OCW_DEADMAN_URL=
# Optional separate CTO staging webhook. Requires cto.enabled, cto.staging_delivery and --enable-staging-delivery.
OCW_DISCORD_CTO_URL=
